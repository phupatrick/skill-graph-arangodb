# Biến môi trường mẫu — copy thành .env rồi sửa giá trị
# KHÔNG commit file .env thật (đã có trong .gitignore)

# Chế độ dữ liệu: auto | jsonl | arango
#   auto   = thử ArangoDB trước, không được thì đọc file JSONL (mặc định)
#   jsonl  = chỉ đọc 12 file trong data/ (không cần cài database)
#   arango = chỉ dùng ArangoDB, kết nối lỗi thì báo lỗi ngay
SKILLGRAPH_DATA_MODE=auto

# Thư mục chứa 12 file .jsonl (mặc định: backend/data)
# SKILLGRAPH_DATA_DIR=

# --- ArangoDB (chỉ cần khi dùng chế độ arango) ---
ARANGO_HOST=http://127.0.0.1:8529
ARANGO_USER=root
ARANGO_PASSWORD=matkhau_doi_di
ARANGO_DATABASE=skill_graph_db
ARANGO_TIMEOUT=3

# --- CORS: các địa chỉ web được phép gọi API ---
# SKILLGRAPH_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
