// ============================================================================
//  PHẦN B — TRUY VẤN NÂNG CAO (GRAPH TRAVERSAL)
// ============================================================================

// --- B1. Nghề yêu cầu những kỹ năng gì (1 tầng) --------------------------
FOR c IN careers
  FILTER c._key == "data_analyst"
  LET yeu_cau = (
    FOR s, e IN 1..1 OUTBOUND c requires_skill
      SORT e.requirement_type, e.importance DESC
      RETURN {
        ky_nang: s.name,
        loai: e.requirement_type,
        muc_can_dat: e.required_level,
        do_quan_trong: e.importance
      }
  )
  RETURN { nghe: c.name, tong_yeu_cau: LENGTH(yeu_cau), yeu_cau: yeu_cau }


// --- B2. SKILL GAP — kỹ năng còn thiếu so với nghề mục tiêu ---------------
// So sánh requires_skill (nghề yêu cầu) với has_skill (người đã có).
// Đây là truy vấn trả lời trực tiếp câu hỏi nghiệp vụ của đề tài.
LET uid = "users/user_001"
FOR c IN careers
  FILTER c._key == "data_analyst"
  LET yeu_cau = (
    FOR s, e IN 1..1 OUTBOUND c requires_skill
      LET hien_co = FIRST(
        FOR hs IN has_skill
          FILTER hs._from == uid AND hs._to == s._id
          RETURN hs.proficiency
      )
      RETURN {
        ky_nang: s.name,
        can: e.required_level,
        hien_co: hien_co,
        trang_thai: hien_co == null ? "THIEU_HAN"
                  : (hien_co < e.required_level ? "CHUA_DU" : "DAT"),
        thieu_bao_nhieu: hien_co == null
                  ? e.required_level
                  : MAX([0, e.required_level - hien_co])
      }
  )
  LET so_dat = LENGTH(FOR x IN yeu_cau FILTER x.trang_thai == "DAT" RETURN 1)
  RETURN {
    nghe: c.name,
    tong_yeu_cau: LENGTH(yeu_cau),
    so_da_dat: so_dat,
    so_con_thieu: LENGTH(yeu_cau) - so_dat,
    ty_le_dap_ung: ROUND(100 * so_dat / LENGTH(yeu_cau), 1),
    chi_tiet: yeu_cau
  }


// --- B3. PREREQUISITE — duyệt nhiều tầng tìm toàn bộ kỹ năng nền ----------
// Điểm mạnh của Graph DB: 1 câu traversal thay cho N vòng lặp ở SQL.
// p.vertices[i] cho biết đường đi; LENGTH(p.vertices)-1 = độ sâu.
FOR s IN skills
  FILTER s._key == "deep_learning"
  LET nen_tang = (
    FOR v, e, p IN 1..5 INBOUND s prerequisite
      RETURN DISTINCT { ky_nang_nen: v.name, do_sau: LENGTH(p.vertices) - 1 }
  )
  RETURN {
    ky_nang: s.name,
    so_ky_nang_nen: LENGTH(nen_tang),
    tang_sau_nhat: MAX(nen_tang[*].do_sau),
    danh_sach: nen_tang
  }


// --- B4. PREREQUISITE — đường đi đầy đủ từ gốc tới đích -------------------
FOR s IN skills
  FILTER s._key == "deep_learning"
  FOR v, e, p IN 1..4 INBOUND s prerequisite
    RETURN {
      duong_di: CONCAT_SEPARATOR(" <- ", p.vertices[*].name),
      do_dai: LENGTH(p.vertices) - 1
    }


// --- B5. KHOÁ HỌC dạy một kỹ năng, kèm nhà cung cấp ----------------------
FOR s IN skills
  FILTER s._key == "python"
  LET khoa_hoc = (
    FOR co, e IN 1..1 INBOUND s teaches
      LET ncc = FIRST(FOR p IN 1..1 OUTBOUND co offered_by RETURN p.name)
      RETURN {
        khoa_hoc: co.title,
        cap_do: co.level,
        so_gio: co.duration_hours,
        vai_tro: e.role,
        nha_cung_cap: ncc
      }
  )
  RETURN { ky_nang: s.name, so_khoa_hoc: LENGTH(khoa_hoc), khoa_hoc: khoa_hoc }


// --- B6. CAREER FIT — điểm phù hợp của user với mọi nghề -----------------
// Công thức: tổng importance của kỹ năng đã đạt / tổng importance yêu cầu.
LET uid = "users/user_001"
LET ky_nang_user = (
  FOR v, e IN 1..1 OUTBOUND DOCUMENT(uid) has_skill
    RETURN { id: v._id, trinh_do: e.proficiency }
)
FOR c IN careers
  LET yeu_cau = (
    FOR s, e IN 1..1 OUTBOUND c requires_skill
      RETURN { id: s._id, can: e.required_level, w: e.importance }
  )
  LET tong_trong_so = SUM(FOR x IN yeu_cau RETURN x.w)
  LET dat_duoc = SUM(
    FOR x IN yeu_cau
      LET co = FIRST(FOR k IN ky_nang_user FILTER k.id == x.id RETURN k.trinh_do)
      FILTER co != null AND co >= x.can
      RETURN x.w
  )
  LET diem = ROUND(100 * dat_duoc / MAX([tong_trong_so, 1]), 1)
  SORT diem DESC
  LIMIT 5
  RETURN { nghe: c.name, diem_phu_hop: diem, so_ky_nang_yeu_cau: LENGTH(yeu_cau) }


// --- B7. KHOÁ HỌC user CHƯA học nhưng cần cho nghề mục tiêu --------------
// "Chưa đạt" = chưa có kỹ năng HOẶC có nhưng proficiency < required_level.
LET uid = "users/user_001"
LET da_hoc = (FOR co IN 1..1 OUTBOUND DOCUMENT(uid) completed RETURN co._id)
LET trinh_do = (
  FOR v, e IN 1..1 OUTBOUND DOCUMENT(uid) has_skill
    RETURN { id: v._id, muc: e.proficiency }
)
FOR c IN careers
  FILTER c._key == "data_analyst"
  FOR s, e IN 1..1 OUTBOUND c requires_skill
    LET muc_hien_tai = FIRST(
      FOR t IN trinh_do FILTER t.id == s._id RETURN t.muc
    )
    FILTER muc_hien_tai == null OR muc_hien_tai < e.required_level
    FOR co IN 1..1 INBOUND s teaches
      FILTER co._id NOT IN da_hoc
      LIMIT 15
      RETURN DISTINCT {
        ky_nang: s.name,
        khoa_hoc: co.title,
        cap_do: co.level,
        so_gio: co.duration_hours
      }


// --- B8. LEARNING PATH — sinh lộ trình có thứ tự -------------------------
// Ý tưởng:
//   (1) lấy kỹ năng nghề yêu cầu mà user CHƯA ĐẠT mức
//   (2) với mỗi kỹ năng, leo ngược prerequisite để lấy kỹ năng nền còn thiếu
//   (3) gộp lại, bỏ trùng
//   (4) sắp xếp theo ĐỘ SÂU NỀN trong đồ thị: nền nông học trước
//       (Python sâu 0 -> học trước; Pandas sâu 1 -> học sau)
// Ghi chú trung thực: đây là heuristic theo độ sâu. Thứ tự chính xác tuyệt
// đối cần topological sort (đã cài trong backend, xem /learning-path).
LET uid = "users/user_001"
LET trinh_do = (
  FOR v, e IN 1..1 OUTBOUND DOCUMENT(uid) has_skill
    RETURN { id: v._id, muc: e.proficiency }
)
LET ung_vien = (
  FOR c IN careers
    FILTER c._key == "data_analyst"
    FOR s, e IN 1..1 OUTBOUND c requires_skill
      LET muc = FIRST(FOR t IN trinh_do FILTER t.id == s._id RETURN t.muc)
      FILTER muc == null OR muc < e.required_level
      LET nen = (
        FOR v, e2, p IN 1..3 INBOUND s prerequisite
          LET muc_nen = FIRST(FOR t IN trinh_do FILTER t.id == v._id RETURN t.muc)
          FILTER muc_nen == null OR muc_nen < e2.required_level
          RETURN { id: v._id, ten: v.name }
      )
      RETURN UNION_DISTINCT([{ id: s._id, ten: s.name }], nen)
)
LET can_hoc = (
  FOR x IN UNIQUE(FLATTEN(ung_vien))
    COLLECT id = x.id, ten = x.ten
    // do_sau = độ sâu prerequisite lớn nhất phía sau kỹ năng này (0 = không cần nền)
    LET cac_tang = (
      FOR v, e, p IN 1..5 INBOUND DOCUMENT(id) prerequisite
        RETURN LENGTH(p.vertices) - 1
    )
    RETURN { id: id, ten: ten, do_sau: LENGTH(cac_tang) ? MAX(cac_tang) : 0 }
)
LET buoc_hoc = (
  FOR c IN can_hoc
    SORT c.do_sau, c.ten
    RETURN c
)
FOR b IN buoc_hoc
  RETURN {
    buoc: POSITION(buoc_hoc[*].id, b.id) + 1,
    ky_nang: b.ten,
    do_sau_prerequisite: b.do_sau
  }


// --- B9. ĐẢO NGƯỢC — kỹ năng này mở khoá được nghề nào -------------------
FOR s IN skills
  FILTER s._key == "python"
  LET nghe = (
    FOR c, e IN 1..1 INBOUND s requires_skill
      RETURN { nghe: c.name, loai: e.requirement_type, can: e.required_level }
  )
  RETURN { ky_nang: s.name, mo_khoa_cho: LENGTH(nghe), danh_sach: nghe }


// --- B10. TOP nhà cung cấp theo số khoá học ------------------------------
FOR p IN providers
  LET so_khoa = LENGTH(FOR co IN 1..1 INBOUND p offered_by RETURN 1)
  SORT so_khoa DESC
  RETURN { nha_cung_cap: p.name, so_khoa_hoc: so_khoa }


// --- B11. SHORTEST PATH giữa 2 kỹ năng qua quan hệ prerequisite ----------
FOR a IN skills
  FILTER a._key == "deep_learning"
  FOR b IN skills
    FILTER b._key == "statistics"
    RETURN {
      tu: a.name,
      den: b.name,
      duong_ngan_nhat: FIRST(
        FOR v, e, p IN ANY SHORTEST_PATH a TO b prerequisite
          RETURN p.vertices[*].name
      )
    }


// --- B12. Kỹ năng KHÔNG có khoá học nào dạy (khoảng trống dữ liệu) -------
FOR s IN skills
  LET so_khoa = LENGTH(FOR co IN 1..1 INBOUND s teaches RETURN 1)
  FILTER so_khoa == 0
  SORT s.name
  LIMIT 20
  RETURN { ky_nang: s.name, nhom: s.category }


// --- B13. Thống kê tổng hợp toàn hệ thống --------------------------------
RETURN {
  so_nguoi_dung: COLLECTION_COUNT("users"),
  so_ky_nang: COLLECTION_COUNT("skills"),
  so_nghe_nghiep: COLLECTION_COUNT("careers"),
  so_khoa_hoc: COLLECTION_COUNT("courses"),
  so_nha_cung_cap: COLLECTION_COUNT("providers"),
  so_canh_has_skill: COLLECTION_COUNT("has_skill"),
  so_canh_targets_career: COLLECTION_COUNT("targets_career"),
  so_canh_requires_skill: COLLECTION_COUNT("requires_skill"),
  so_canh_prerequisite: COLLECTION_COUNT("prerequisite"),
  so_canh_teaches: COLLECTION_COUNT("teaches"),
  so_canh_completed: COLLECTION_COUNT("completed"),
  so_canh_offered_by: COLLECTION_COUNT("offered_by")
}
