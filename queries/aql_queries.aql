// ============================================================================
//  SKILL GRAPH — BỘ TRUY VẤN AQL CHO ĐỒ ÁN
//  Database: skill_graph_db   |   Graph: skill_graph   |   ArangoDB 3.12
// ----------------------------------------------------------------------------
//  Cách dùng:
//    1. Mở http://127.0.0.1:8529  →  đăng nhập  →  chọn DB skill_graph_db
//    2. Tab QUERIES  →  dán MỘT khối (từ dòng "--- A1" tới trước khối kế)
//    3. Run  →  chụp ảnh kết quả để đưa vào báo cáo
//
//  LƯU Ý: chạy từng khối, đừng bôi đen cả file rồi Run.
// ============================================================================


// ============================================================================
//  PHẦN A — TRUY VẤN CƠ BẢN
// ============================================================================

// --- A1. Đếm số bản ghi của cả 12 collection ------------------------------
FOR name IN ["users","skills","careers","courses","providers",
             "has_skill","targets_career","requires_skill",
             "prerequisite","teaches","completed","offered_by"]
  RETURN { collection: name, so_ban_ghi: COLLECTION_COUNT(name) }


// --- A2. Liệt kê 10 nghề nghiệp ------------------------------------------
FOR c IN careers
  SORT c.name
  LIMIT 10
  RETURN { _key: c._key, ten: c.name, linh_vuc: c.category }


// --- A3. Tìm kỹ năng theo từ khoá ----------------------------------------
LET tu_khoa = "python"
FOR s IN skills
  FILTER CONTAINS(LOWER(s.name), LOWER(tu_khoa))
  SORT s.name
  RETURN { _key: s._key, ten: s.name, nhom: s.category }


// --- A4. Lọc kỹ năng theo nhóm -------------------------------------------
FOR s IN skills
  FILTER s.category == "Programming"
  SORT s.name
  LIMIT 20
  RETURN s.name


// --- A5. Một người dùng và toàn bộ kỹ năng hiện có ------------------------
FOR u IN users
  FILTER u._key == "user_001"
  LET ky_nang = (
    FOR v, e IN 1..1 OUTBOUND u has_skill
      SORT v.name
      RETURN { ten: v.name, trinh_do: e.proficiency }
  )
  RETURN {
    ho_ten: u.full_name,
    email: u.email,
    so_ky_nang: LENGTH(ky_nang),
    ky_nang: ky_nang
  }


// --- A6. Nghề mục tiêu của người dùng ------------------------------------
FOR u IN users
  FILTER u._key == "user_001"
  FOR v, e IN 1..1 OUTBOUND u targets_career
    RETURN { nguoi_dung: u.full_name, nghe_muc_tieu: v.name, uu_tien: e.priority }


// --- A7. Khoá học đã hoàn thành của một người ----------------------------
FOR u IN users
  FILTER u._key == "user_001"
  FOR v, e IN 1..1 OUTBOUND u completed
    SORT e.completed_at DESC
    RETURN { khoa_hoc: v.title, diem: e.score, tien_do: e.progress, ngay: e.completed_at }


// --- A8. CRUD — thêm một người dùng mới ----------------------------------
// Bỏ comment 4 dòng dưới để chạy. Chạy lại lần 2 sẽ báo trùng _key (đúng).
